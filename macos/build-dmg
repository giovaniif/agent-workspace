#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
out="${1:-build/crew.dmg}"
stage="$(mktemp -d)"
work="$(mktemp -d)"
trap 'rm -rf "$stage" "$work"' EXIT
cp -R build/crew.app "$stage/crew.app"
ln -s /Applications "$stage/Applications"
cp build/crew.app/Contents/Resources/AppIcon.icns "$stage/.VolumeIcon.icns"
hdiutil create -volname crew -srcfolder "$stage" -fs HFS+ -format UDRW "$work/rw.dmg"
mkdir "$work/mnt"
hdiutil attach "$work/rw.dmg" -mountpoint "$work/mnt" -nobrowse -noautoopen
SetFile -a C "$work/mnt"
hdiutil detach "$work/mnt"
rm -f "$out"
hdiutil convert "$work/rw.dmg" -format UDZO -o "$out"
echo "$out"
