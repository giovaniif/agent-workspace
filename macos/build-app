#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
config="${1:-release}"
version="${CREW_APP_VERSION:-${AGENTWS_APP_VERSION:-v0.0.0}}"
binaries="${CREW_APP_BINARIES:-${AGENTWS_APP_BINARIES:-}}"
name=crew
[ -n "${CREW_APP_BINARIES:-}" ] || [ -z "${AGENTWS_APP_BINARIES:-}" ] || name=agentws
swift build -c "$config" --product AgentwsApp
bin="$(swift build -c "$config" --show-bin-path)/AgentwsApp"
app=build/crew.app
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp Info.plist "$app/Contents/Info.plist"
short="${version#v}"
short="${short%%-*}"
plutil -replace CFBundleShortVersionString -string "$short" "$app/Contents/Info.plist"
plutil -replace CFBundleVersion -string "${CREW_APP_BUILD:-${AGENTWS_APP_BUILD:-0}}" "$app/Contents/Info.plist"
plutil -replace AgentwsVersion -string "$version" "$app/Contents/Info.plist"
cp "$bin" "$app/Contents/MacOS/crew"
cp ../docs/images/brand/crewTemplate.png ../docs/images/brand/crewTemplate@2x.png "$app/Contents/Resources/"
iconset="$(mktemp -d)/AppIcon.iconset"
mkdir -p "$iconset"
for size in 16 32 128 256 512; do
  sips -z "$size" "$size" AppIcon.png --out "$iconset/icon_${size}x${size}.png" >/dev/null
  double=$((size * 2))
  sips -z "$double" "$double" AppIcon.png --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
done
iconutil -c icns "$iconset" -o "$app/Contents/Resources/AppIcon.icns"
rm -rf "$(dirname "$iconset")"
if [ -n "$binaries" ]; then
  for target in darwin_arm64 darwin_amd64 linux_amd64 linux_arm64; do
    src="$binaries/$target/$name"
    [ -f "$src" ] || { echo "missing $src" >&2; exit 1; }
    mkdir -p "$app/Contents/Resources/bin/$target"
    cp "$src" "$app/Contents/Resources/bin/$target/crew"
    chmod +x "$app/Contents/Resources/bin/$target/crew"
  done
fi
codesign --force --deep --sign - "$app"
echo "$app"
