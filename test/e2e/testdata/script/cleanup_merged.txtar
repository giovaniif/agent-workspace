repo api
exec crew workspace add api
exec crew new --workspace api 'ship two parts'
capture SID '^session (\S+) on pane'
eventually ' state=done ' crew debug session --once $SID
mkdir $CREW_E2E/gates/end
eventually ' state=idle ' crew debug session --once $SID
eventually '/api-b\s+feat-b\s+'$SID'\s' crew worktree list
capture A '^(\S+/api-a)\s'
capture B '^(\S+/api-b)\s'

cp prs-merged.json prs.json
eventually '/api-a","branch":"feat-a","action":"remove",.*"outcome":"removed"' cat $CREW_HOME/cleanup.log
! exists $A
exists $B/b.txt
exec git -C api branch --list feat-a
stdout 'feat-a'
! eventually '/api-a\s' crew worktree list
stdout '/api-b\s+feat-b\s+'$SID'\s'
exec crew cleanup
stdout '^keep\s+\S+/api-b\s+feat-b\s+not merged\s+kept$'
! stdout 'api-a'

-- claude.steps --
hook UserPromptSubmit {"prompt":"ship two parts"}
run git worktree add -q -b feat-a ../api-a && cd ../api-a && echo a > a.txt && git add a.txt && git commit -qm a
run git worktree add -q -b feat-b ../api-b && cd ../api-b && echo b > b.txt && git add b.txt && git commit -qm b
hook Stop
gate end
hook SessionEnd
-- prs-merged.json --
{"data":{"r0":{"pullRequests":{"nodes":[
  {"number":7,"title":"Part a","url":"https://github.com/o/api/pull/7","headRefName":"feat-a","state":"MERGED",
   "reviewDecision":"APPROVED","mergeable":"UNKNOWN",
   "reviewThreads":{"nodes":[]},"comments":{"nodes":[]},"reviews":{"nodes":[]},"commits":{"nodes":[]}}]}}}}
