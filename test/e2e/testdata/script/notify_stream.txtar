! exec sh -c 'exec crew notify stream 2>$WORK/stream.err' &stream&
eventually '^crew notify stream: waiting for the daemon$' cat stream.err
exec crew daemon start
stdout '^crew daemon started \(pid [0-9]+\)$'
eventually '^crew notify stream: connected$' cat stream.err

repo api
exec crew workspace add api
exec crew new --workspace api 'add a thing'
capture SID '^session (\S+) on pane %\d+$'
eventually ' state=done ' crew debug session --once $SID

exec crew daemon stop
wait stream
stdout '"Group":"'$SID'"'
eventually 'daemon went away' cat stream.err

-- claude.steps --
hook UserPromptSubmit {"prompt":"add a thing"}
hook Stop {"last_assistant_message":"Added it."}
