exec crew daemon start
exec tmux -L $CREW_TMUX_SOCKET new-session -d -s tui -x 48 -y 24 -e CREW_HOME=$CREW_HOME -e CREW_NO_UPDATE_CHECK=1 crew tui
eventually 'Set up crew' tmux -L $CREW_TMUX_SOCKET capture-pane -p -t tui
exec tmux -L $CREW_TMUX_SOCKET send-keys -t tui Escape
eventually '0 sessions' tmux -L $CREW_TMUX_SOCKET capture-pane -p -t tui

exec crew daemon stop
eventually 'daemon disconnected' tmux -L $CREW_TMUX_SOCKET capture-pane -p -t tui
eventually 'reconnecting · try \d+' tmux -L $CREW_TMUX_SOCKET capture-pane -p -t tui

exec crew daemon start
! eventually 'daemon disconnected' tmux -L $CREW_TMUX_SOCKET capture-pane -p -t tui
exec crew debug seed 1
eventually '1 session · 1 worktree' tmux -L $CREW_TMUX_SOCKET capture-pane -p -t tui

exec crew daemon stop
eventually 'daemon disconnected' tmux -L $CREW_TMUX_SOCKET capture-pane -p -t tui
exec tmux -L $CREW_TMUX_SOCKET send-keys -t tui q
eventually '^gone$' sh -c 'tmux -L "$CREW_TMUX_SOCKET" has-session -t tui 2>/dev/null || echo gone'
