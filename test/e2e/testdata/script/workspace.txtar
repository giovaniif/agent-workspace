symlink shop/linked -> ../elsewhere/linked

exec agentws workspace add shop
stdout '^added .*/shop \(orchestration, 3 repos\)$'

exec agentws workspace add solo
stdout '^added .*/solo \(single, 1 repo\)$'

exec agentws workspace list
stdout '^\S*/shop \(orchestration\)$'
stdout '^\S*/solo \(single, last used\)$'
stdout '^  api\s'
stdout '^  linked\s'
stdout '^  web\s'
stdout '^  solo\s'
! stdout 'api-feature'
! stdout 'docs'

exec agentws daemon stop
exec agentws workspace list
stdout '^\S*/solo \(single, last used\)$'

exec agentws workspace remove shop
stdout '^removed .*/shop$'
exec agentws workspace list
! stdout 'shop'

! exec agentws workspace remove shop
stderr 'crew workspace: not_found: no workspace '

! exec agentws workspace add missing
stderr '^crew workspace: bad_request: .*missing'

! exec agentws workspace
stderr '^usage: crew workspace <add\|list\|remove>'

-- shop/api/.git/HEAD --
ref: refs/heads/main
-- shop/web/.git/HEAD --
ref: refs/heads/main
-- shop/api-feature/.git --
gitdir: /elsewhere/api/.git/worktrees/feature
-- shop/docs/README.md --
notes
-- elsewhere/linked/.git/HEAD --
ref: refs/heads/main
-- solo/.git/HEAD --
ref: refs/heads/main
