env CREW_NO_UPDATE_CHECK=
mkdir $CREW_HOME
cp release.json $CREW_HOME/release.json
exec crew version
stdout 'v9\.0\.0-alpha\.1 is available'
stdout 'crew daemon stop'

env CREW_NO_UPDATE_CHECK=1
exec crew version
! stdout 'is available'

-- release.json --
{"tag":"v9.0.0-alpha.1","checked":"2999-01-01T00:00:00Z"}
