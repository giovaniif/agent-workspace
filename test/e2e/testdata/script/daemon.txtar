exec agentws daemon start
stdout '^crew daemon started \(pid [0-9]+\)$'
exists $AGENTWS_HOME/agentws.pid

exec agentws daemon status
stdout '^pid [0-9]+$'
stdout '^uptime '
stdout '^sessions 0$'
stdout '^worktrees 0$'

! exec agentws daemon
stderr '^crew daemon: already running \(pid [0-9]+\)$'

exec agentws daemon start
stdout '^crew daemon already running \(pid [0-9]+\)$'

exec agentws daemon stop
stdout '^crew daemon stopped \(pid [0-9]+\)$'
! exec agentws daemon status
stderr '^crew daemon: not running$'
! exists $AGENTWS_HOME/agentws.pid

! exec agentws daemon stop
stderr 'not running'
