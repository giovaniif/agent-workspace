repo api
exec crew workspace add api
exec crew new --workspace api 'split the work'
capture SID '^session (\S+) on pane'

eventually '/api-a\s+feat-a\s+'$SID'\s' crew worktree list
eventually '/api-b\s+feat-b\s+'$SID'\s' crew worktree list

-- claude.steps --
hook UserPromptSubmit {"prompt":"split the work"}
run git worktree add -q -b feat-a ../api-a
run git worktree add -q -b feat-b ../api-b
hook Stop
