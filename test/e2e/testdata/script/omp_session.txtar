repo api
exec crew workspace add api
exec crew new --workspace api --harness omp --model sonnet 'add a thing'
capture SID '^session (\S+) on pane %\d+$'

mkdir $CREW_E2E/gates/prompt
eventually '^seq=\d+ state=running harness=omp .* model=opus effort=high ' crew debug session --once $SID
mkdir $CREW_E2E/gates/round
eventually ' state=permission ' crew debug session --once $SID
mkdir $CREW_E2E/gates/finish
eventually ' state=done harness=omp ' crew debug session --once $SID

-- omp.steps --
gate prompt
hook session_start {}
hook agent_start {"model":"opus","effort":"high"}
gate round
hook tool_call {"tool_name":"bash","tool_input":{"command":"ls"}}
hook turn_end {}
hook tool_approval_requested {"tool_name":"bash"}
gate finish
hook agent_end {}
