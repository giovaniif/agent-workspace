#!/bin/sh
harness=${CREW_E2E_HARNESS:-claude}
steps="$CREW_E2E/$harness.steps"

hook() {
	payload=$2
	[ -n "$payload" ] || payload='{}'
	log="$CREW_HOME/hook.log"
	try=0
	while :; do
		before=$(cat "$log" 2>/dev/null | wc -l)
		printf '%s' "$payload" | crew hook --harness "$harness" --event "$1"
		after=$(cat "$log" 2>/dev/null | wc -l)
		[ "$after" -gt "$before" ] || return 0
		last=$(tail -n 1 "$log")
		case $last in *"no reply within"*) return 0 ;; esac
		try=$((try + 1))
		[ "$try" -lt 5 ] || return 0
		echo "hook $1 dropped ($last), firing again" >>"$CREW_E2E/$harness.log"
	done
}

tool_payload() {
	cmd=$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')
	printf '{"cwd":"%s","tool_name":"Bash","tool_input":{"command":"%s"}}' "$PWD" "$cmd"
}

gate() {
	i=0
	while [ ! -e "$CREW_E2E/gates/$1" ]; do
		i=$((i + 1))
		if [ "$i" -gt 1500 ]; then
			echo "gate $1 never opened" >>"$CREW_E2E/$harness.log"
			exit 1
		fi
		sleep 0.02
	done
}

exec 3<"$steps"
while IFS= read -r line <&3; do
	verb=${line%% *}
	rest=${line#"$verb"}
	rest=${rest# }
	case $verb in
	hook)
		event=${rest%% *}
		json=${rest#"$event"}
		hook "$event" "${json# }"
		;;
	run)
		hook PreToolUse "$(tool_payload "$rest")"
		sh -c "$rest" >>"$CREW_E2E/$harness.log" 2>&1
		hook PostToolUse "$(tool_payload "$rest")"
		;;
	gate) gate "$rest" ;;
	read)
		stty -echo
		exec cat >"$CREW_E2E/$rest"
		;;
	esac
done
exec tail -f /dev/null
