#!/usr/bin/env bash
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
home=${CREW_DEV_HOME:-/tmp/crew-dev-$(id -u)}
socket=${CREW_DEV_SOCKET:-crew-dev}
bin=$home/bin/crew
log=$home/dev.log
pidfile=$home/dev-watch.pid
version_pkg=github.com/giovaniif/crew/internal/version

export CREW_HOME=$home
export CREW_TMUX_SOCKET=$socket
mkdir -p "$home/bin"

if [ "${FAKES:-}" = 1 ]; then
	export PATH="$repo/test/e2e/testdata/bin:$PATH"
	export AGENTWS_E2E=$home/e2e
	mkdir -p "$AGENTWS_E2E"
	touch "$AGENTWS_E2E/claude.steps" "$AGENTWS_E2E/codex.steps"
fi

note() {
	printf '%s %s\n' "$(date +%H:%M:%S)" "$*" >>"$log"
	tmux -L "$socket" display-message -d 5000 "crew dev: $*" 2>/dev/null || true
}

build() {
	local commit tmp
	commit=$(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo none)
	tmp=$bin.new
	if ! (cd "$repo" && go build -ldflags "-X $version_pkg.Version=dev -X $version_pkg.Commit=$commit.$(date +%s)" -o "$tmp" ./cmd/crew) >"$home/build.log" 2>&1; then
		cat "$home/build.log" >>"$log"
		note "build failed, still running the last good build: $(grep -v '^#' "$home/build.log" | head -n 1) (see $log)"
		return 1
	fi
	mv -f "$tmp" "$bin"
}

restart() {
	local out
	if ! out=$("$bin" daemon stop 2>&1) && [[ $out != *"not running"* ]]; then
		note "could not stop the dev daemon: $out"
		return 1
	fi
	"$bin" daemon start >>"$log" 2>&1
	tmux -L "$socket" list-panes -a -F '#{pane_id} #{pane_start_command}' 2>/dev/null |
		while read -r pane cmd; do
			case $cmd in
			*"$bin"*tui*) tmux -L "$socket" respawn-pane -k -t "$pane" ;;
			esac
		done || true
	note "reloaded $("$bin" version)"
}

sources() {
	find "$repo/cmd" "$repo/internal" "$repo/go.mod" "$repo/go.sum" \( -name '*.go' -o -name '*.xml' -o -name 'go.*' \) "$@" 2>/dev/null
}

sources_changed() {
	local names
	names=$(sources -print | sort | cksum)
	[ "$names" != "$(cat "$home/sources" 2>/dev/null)" ] || [ -n "$(sources -newer "$home/sources" -print -quit)" ]
}

mark_sources() {
	sources -print | sort | cksum >"$home/sources"
}

watch() {
	while sleep 1; do
		if sources_changed; then
			mark_sources
			build && restart
		fi
	done
}

stop_watcher() {
	if [ -f "$pidfile" ]; then
		kill "$(cat "$pidfile")" 2>/dev/null || true
		rm -f "$pidfile"
	fi
}

stop_own_watcher() {
	kill "$watcher" 2>/dev/null || true
	if [ "$(cat "$pidfile" 2>/dev/null)" = "$watcher" ]; then
		rm -f "$pidfile"
	fi
}

if [ "${1:-}" = stop ]; then
	stop_watcher
	[ -x "$bin" ] && "$bin" daemon stop || true
	exit 0
fi

mark_sources
if ! build; then
	cat "$home/build.log" >&2
	exit 1
fi
restart
if [ -n "${SEED:-}" ]; then
	"$bin" debug seed "$SEED"
fi

stop_watcher
watch &
watcher=$!
echo "$watcher" >"$pidfile"
trap stop_own_watcher EXIT
echo "crew dev: home $home, tmux -L $socket, log $log"
"$bin"
