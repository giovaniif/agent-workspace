{
  "theme": "dark",
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(ls:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tmux set -w @agent-done 1"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/crew/bin/crew hook --harness claude --event Stop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/guard.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/crew/bin/crew hook --harness claude --event PreToolUse"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/crew/bin/crew hook --harness claude --event SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/crew/bin/crew hook --harness claude --event UserPromptSubmit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/crew/bin/crew hook --harness claude --event PostToolUse"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/crew/bin/crew hook --harness claude --event Notification"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/crew/bin/crew hook --harness claude --event PermissionRequest"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/crew/bin/crew hook --harness claude --event SubagentStart"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/crew/bin/crew hook --harness claude --event SubagentStop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/crew/bin/crew hook --harness claude --event SessionEnd"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/opt/crew/bin/crew statusline --harness claude --chain '~/.claude/statusline.sh'",
    "padding": 1
  }
}
